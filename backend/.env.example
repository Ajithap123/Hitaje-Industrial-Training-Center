PORT=8080
NODE_ENV=production
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_USERNAME=choose-a-unique-admin-username
ADMIN_PASSWORD=choose-a-long-unique-admin-password
# Alternatively set ADMIN_PASSWORD_HASH to a bcrypt hash instead of ADMIN_PASSWORD.
# DATA_FILE should point to persistent storage in production.
DATA_FILE=./data.json
CORS_ORIGINS=*
